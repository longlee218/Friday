# Copy to .env and fill in. .env is gitignored and must never be committed.
# Secrets only — anything that is not a secret belongs in config.yaml, where a
# change is a reviewable diff.

# ── Discord ────────────────────────────────────────────────────────────────
# The watched account's token. This is unscoped access to the whole account:
# keep it out of logs, tracebacks, and anything you paste elsewhere. It dies on
# a password change or a 2FA toggle, not on a timer.
DISCORD_USER_TOKEN=

# The bot that sends approval cards. Needed from ticket 06 onward; leave empty
# until then.
DISCORD_BOT_TOKEN=

# ── Model keys ─────────────────────────────────────────────────────────────
# One per agent, referenced from config.yaml as ${VAR}. Separate variables even
# when both point at the same provider: it lets you bill, rate-limit or rotate
# them independently, and swap one agent to another provider without touching
# the other.
#
#   OpenAI    https://platform.openai.com/api-keys
#   DeepSeek  https://platform.deepseek.com/api_keys
#   MiniMax   https://platform.minimaxi.com  (account console)
TRIAGE_API_KEY=
RESPONDER_API_KEY=

# ── Optional ───────────────────────────────────────────────────────────────
# DEBUG shows every message seen before scoping, and why anything was dropped.
LOG_LEVEL=INFO
